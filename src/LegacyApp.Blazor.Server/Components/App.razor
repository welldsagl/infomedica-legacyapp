<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/LegacyApp.Blazor.Shared/app.css" />
    <HeadOutlet @rendermode="RenderMode" />
</head>

<body>
    <Routes @rendermode="RenderMode" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // prerender: false -> un solo ciclo di vita per componente (OnInitialized una volta sola),
    // il modello piu' simile a WinForms. Costo: pagina vuota per un istante finche' SignalR si connette.
    private static readonly IComponentRenderMode RenderMode = new InteractiveServerRenderMode(prerender: false);
}
